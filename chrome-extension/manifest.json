{
  "manifest_version": 3,
  "name": "wbapp Canvas Bridge",
  "version": "0.1.1",
  "description": "When open, your laptop fulfills Canvas sync requests from your iPad — no access token required.",
  "action": {
    "default_title": "wbapp Canvas Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://*/*", "http://localhost:*/*", "http://127.0.0.1:*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
